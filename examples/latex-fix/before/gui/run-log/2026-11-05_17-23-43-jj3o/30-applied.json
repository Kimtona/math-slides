      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "mathBlock",
            "attrs": {
              "latex": "\\\\(J_{PPO}(\\theta) = \\mathbb{E}[q \\sim P(Q), o \\sim \\pi_{\\theta_{old}}(O|q)] \\frac{1}{|o|} \\sum_{t=1}^{|o|} \\min \\left[ \\frac{\\pi_{\\theta}(o_t|q, o_{<t})}{\\pi_{\\theta_{old}}(o_t|q, o_{<t})} A_t, \\text{clip} \\left( \\frac{\\pi_{\\theta}(o_t|q, o_{<t})}{\\pi_{\\theta_{old}}(o_t|q, o_{<t})}, 1-\\varepsilon, 1+\\varepsilon \\right) A_t \\right],"
            }
          }
        ]
      },
      "style": {
        "fontSize": 20,
